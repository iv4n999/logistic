/* ==================== ИТОГОВАЯ СЕКЦИЯ И КАЛЬКУЛЯТОР ==================== */

.summary-section {
    background: var(--color-gray-900);
    color: var(--color-white);
}

.summary-section h3 {
    color: var(--color-white);
}

.calculator {
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 20px;
}

.calculator h3 {
    margin-bottom: 16px;
    font-size: 16px;
    color: var(--color-white);
}

.calculator-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.calculator-placeholder {
    color: var(--color-gray-400);
    text-align: center;
    padding: 20px;
}

.calculator-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 14px;
    color: var(--color-gray-300);
}

.calculator-row:last-child {
    border-bottom: none;
}

.calculator-row.discount {
    color: #6EE7B7;
}

.calculator-total {
    display: flex;
    justify-content: space-between;
    padding-top: 16px;
    margin-top: 8px;
    border-top: 2px solid rgba(255, 255, 255, 0.2);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-white);
}

.calculator-total span:last-child {
    color: #93C5FD;
}

/* Кнопка отправки */
.submit-btn {
    width: 100%;
    padding: 18px 24px;
    background: var(--color-primary);
    color: var(--color-white);
    border: none;
    border-radius: var(--radius-md);
    font-size: 16px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: all 0.15s;
}

.submit-btn:hover:not(:disabled) {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
}

.submit-btn:disabled {
    background: var(--color-gray-600);
    cursor: not-allowed;
    opacity: 0.7;
}
